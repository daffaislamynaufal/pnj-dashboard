# Geraikita AI API Configuration
# Dapatkan API Key di https://ai.geraikita.com/dashboard (Berbayar) atau https://ai.geraikita.com/bansos (Gratis/Bansos)

# Jalur Berbayar (Default)
GERAIKITA_API_KEY=gk-xxxxxxxxxxxxxxxxxxxx
GERAIKITA_OPENAI_BASE_URL=https://ai.geraikita.com/v1
GERAIKITA_ANTHROPIC_BASE_URL=https://ai.geraikita.com

# Jalur Bansos (Gratis)
# GERAIKITA_BANSOS_KEY=gk-bansos-xxxxxxxxxxxx
# GERAIKITA_BANSOS_OPENAI_BASE_URL=https://ai.geraikita.com/v1/claude
# GERAIKITA_BANSOS_ANTHROPIC_BASE_URL=https://ai.geraikita.com/v1/claude

# 9Router Local Endpoint (jika menggunakan 9Router)
NINEROUTER_BASE_URL=http://localhost:20128/v1
